{
  "name": "dsh-pet-seen",
  "version": "0.1.1",
  "description": "Bridge between DeepSeek Harness and a local desktop pet: session event push, per-session progress buckets, and 'user has actually seen it' notice acknowledgement.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "desktop-pet",
    "notifications",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "starwithfox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starwithfox/dsh-pet-seen.git"
  },
  "homepage": "https://github.com/starwithfox/dsh-pet-seen#readme",
  "bugs": {
    "url": "https://github.com/starwithfox/dsh-pet-seen/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "protocol",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json --noEmit",
    "compat:0.2.0": "tsc -p tsconfig.compat-0.2.0.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node tools/run-tests.mjs",
    "smoke:bundle": "node tools/smoke-bundle.mjs",
    "roundtrip": "node tools/roundtrip.mjs",
    "auth:check": "node tools/check-browser-auth.mjs",
    "probe:http": "node tools/probe-http.mjs",
    "acceptance": "node tools/cdp-acceptance.mjs",
    "check:artifacts": "git diff --exit-code HEAD -- lib client",
    "check": "npm run typecheck && npm run build && npm run smoke:bundle && npm run check:artifacts && npm test",
    "mock-pet": "node tools/mock-pet.mjs",
    "receiver:check": "python tools/min-receiver-check.py"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "^0.1.5-rc.2 || ^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  }
}
