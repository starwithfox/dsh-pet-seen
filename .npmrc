# Keep npm's cache inside the repository (`.npm-cache/`, gitignored).
# The default cache lives outside the DSH workspace write sandbox, so
# `npm view` / `npm install` fail with EPERM before any network work happens.
# This redirect makes the registry reachable. The path must stay repo-relative:
# this repo is standalone, so a `../` target would land outside the clone.
cache=.npm-cache
audit=false
fund=false
